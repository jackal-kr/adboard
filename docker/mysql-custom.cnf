# mysql-custom.cnf — mounted into the db container
# Path in container: /etc/mysql/conf.d/99-custom.cnf

[mysqld]
# Character set — required by Joomla 4+
character-set-server      = utf8mb4
collation-server          = utf8mb4_unicode_ci

# Performance tuning (adjust to your RAM)
innodb_buffer_pool_size   = 128M
innodb_log_file_size      = 32M
max_connections           = 50
query_cache_type          = 0       # disabled; use ProxySQL or app-level cache

# Dev convenience
slow_query_log            = 1
slow_query_log_file       = /var/lib/mysql/slow.log
long_query_time           = 2

[client]
default-character-set     = utf8mb4
